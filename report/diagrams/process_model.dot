digraph G {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.2, nodesep=0.35, ranksep=0.32, fontname="DejaVu Sans", fontsize=12, compound=true];
  node  [fontname="DejaVu Sans", fontsize=10, color="#0E1E33", penwidth=1.2];
  edge  [color="#3D5A80", penwidth=1.2, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9, fontcolor="#52514e"];
  subgraph cluster_online {
    label=<<b>A. Online detection at the IoT gateway (runs continuously)</b>>; color="#0E9AA7"; style="rounded"; fontcolor="#0E1E33";
    start [shape=oval, style=filled, fillcolor="#0E1E33", fontcolor="white", label="Start"];
    cap [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Capture packets from all IoT devices\n(network tap / mirror port)"];
    win [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Group packets into a window\n(10 or 100 packets between two hosts)"];
    feat [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Compute the CICIoT2023 features\n(46, or the selected top-k)"];
    scale [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Scale with the saved StandardScaler"];
    clf [shape=box, style="rounded,filled", fillcolor="#D7EFF1", color="#0E9AA7", label="Classify with the deployed model\n+ tuned per-class weights"];
    att [shape=diamond, style=filled, fillcolor="#FDEBD0", color="#B7791F", label="Attack?"];
    logb [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Update benign\ntraffic counters"];
    alert [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Create alert: device, category,\nattack type, confidence"];
    sev [shape=diamond, style=filled, fillcolor="#FDEBD0", color="#B7791F", label="Severe?\n(e.g. brute force,\nweb attack)"];
    notify [shape=box, style="rounded,filled", fillcolor="#F8D7CF", color="#E4572E", label="Notify administrator now;\noptionally isolate the device"];
    publish [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Publish alert to the cloud\n(MQTT over TLS)"];
    start -> cap -> win -> feat -> scale -> clf -> att;
    att -> logb [label=" no"];
    att -> alert [label=" yes"];
    alert -> sev;
    sev -> notify [label=" yes"];
    sev -> publish [label=" no"];
    notify -> publish;
    logb -> cap [constraint=false, style=dashed, label=" next window"];
  }
  subgraph cluster_offline {
    label=<<b>B. Offline training in the cloud (periodic)</b>>; color="#B7791F"; style="rounded"; fontcolor="#0E1E33";
    data [shape=cylinder, style=filled, fillcolor="#EEF3F7", label="Labelled flows\n(CICIoT2023 + stored alerts)"];
    prep [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Sample, remove duplicates,\nfrozen train / val / test split"];
    fs [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Rank features on training data,\nkeep top-k"];
    bal [shape=box, style="rounded,filled", fillcolor="#D7EFF1", color="#0E9AA7", label="Handle imbalance on training data only\n(SMOTE / hybrid / class weights /\nthreshold tuning on validation)"];
    tr [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Train models (DT, RF, LightGBM, BRF)"];
    ev [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Evaluate on the untouched test set\n(per-class recall, macro-F1,\nbootstrap CI, McNemar)"];
    ok [shape=diamond, style=filled, fillcolor="#FDEBD0", color="#B7791F", label="Meets recall,\nlatency and size\ntargets?"];
    pkg [shape=box, style="rounded,filled", fillcolor="#EEF3F7", label="Package scaler + features + model,\nsign with SHA-256"];
    data -> prep -> fs -> bal -> tr -> ev -> ok;
    ok -> pkg [label=" yes"];
    ok -> bal [label=" no: next method / k", constraint=false, style=dashed];
  }
  pkg -> clf [label=" model update service", style=bold, color="#0E9AA7", fontcolor="#0E9AA7", constraint=false];
  publish -> data [label=" alerts feed retraining", style=dashed, constraint=false];
}
