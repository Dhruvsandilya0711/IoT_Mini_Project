digraph G {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.2, nodesep=0.3, ranksep=0.55, fontname="DejaVu Sans"];
  node  [fontname="DejaVu Sans", fontsize=10, color="#0E1E33", style="rounded,filled", fillcolor="#EEF3F7", shape=box];
  edge  [color="#3D5A80", penwidth=1.3, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9, fontcolor="#52514e"];
  wifi [label="Wi-Fi / Ethernet\nIoT devices"];
  zig [label="Zigbee / Z-Wave devices\n+ hubs"];
  mal [label="Malicious IoT devices", fillcolor="#F8D7CF", color="#E4572E"];
  ap [label="Access point /\nswitch"];
  tap [label="Network tap\n(or switch mirror port)", fillcolor="#FDEBD0", color="#B7791F"];
  pi [label=<<b>Raspberry Pi 4 gateway</b><br/><font point-size="9">tcpdump capture → feature extractor<br/>→ scaler + model → alert client</font>>, fillcolor="#D7EFF1", color="#0E9AA7"];
  router [label="Router / Internet"];
  cloud [label=<<b>Cloud VM</b><br/><font point-size="9">MQTT broker (TLS), database,<br/>dashboard, model registry,<br/>training jobs (Kaggle in this project)</font>>];
  wifi -> ap; zig -> ap [label=" via hubs"]; mal -> ap;
  ap -> router [label=" normal traffic"];
  ap -> tap [label=" copy of all traffic", style=dashed];
  tap -> pi [style=dashed];
  pi -> router [label=" alerts (MQTT/TLS)"];
  router -> cloud;
  cloud -> pi [label=" model updates (HTTPS)", constraint=false, style=dotted];
}
